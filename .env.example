# ── Supabase (required for auth + data) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider selection ───────────────────────────────────────────────
# local (default, deterministic engine — no keys needed) | ollama | anthropic
LEARNING_LOOP_AI_PROVIDER=local
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Python ML backend (FastAPI: classify/retrieve/generate/tutor) ───────
ML_BACKEND_URL=http://localhost:8000

# ── Payments (Razorpay scaffolding) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Analytics / URLs ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
